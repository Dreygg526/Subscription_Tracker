# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- App ---
# Public URL of the deployed app. Used to build the magic-link redirect.
NEXT_PUBLIC_SITE_URL=https://app.yourbrand.com

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=you@yourbrand.com

# Where a locked-out customer is sent to buy a qualifying bundle.
NEXT_PUBLIC_OFFER_URL=https://yourbrand.com/products/your-supplement

# Shown in the UI.
NEXT_PUBLIC_BRAND_NAME=Your Brand
NEXT_PUBLIC_PRODUCT_NAME=Liver Detox

# --- Hosts ---
# Admin is a separate entity on its own hostname, served from this same app.
# Chromium resolves any *.localhost to 127.0.0.1, so no hosts-file edit is
# needed in development. In production add ADMIN_HOST as a second Vercel domain.
NEXT_PUBLIC_APP_HOST=app.yourbrand.com
NEXT_PUBLIC_ADMIN_HOST=admin.yourbrand.com

# --- Gate ---
# false: the bundle the customer picks in onboarding sizes their challenge.
# true:  only an imported Shopify order can unlock the tracker.
# A real order always wins over a claim either way; this only decides whether a
# claim on its own is enough. Turn this on once order import is routine.
REQUIRE_ORDER_MATCH=false

# --- Android app ---
# Public URL of the signed APK, e.g. https://app.yourbrand.com/app/tracker.apk
# Leave EMPTY until it is built and hosted -- /install then shows the
# add-to-home-screen route instead of a dead download link.
NEXT_PUBLIC_APK_URL=
